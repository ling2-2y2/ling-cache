{
  "name": "@ling2/ling-cache",
  "version": "1.2.1",
  "description": "Cache hub for cordis-based hosts: named cache-store registry with TTL semantics, the verbatim Ling CacheKeyUtil key replica, an in-memory store, a distributed lock, a key-based delay task queue, a token-owned renewable Redis lock, a raw command face, and an ioredis-backed provider.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "author": "ling2-2y2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ling2-2y2/ling-cache.git"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cache",
    "redis",
    "cordis",
    "ttl",
    "distributed-lock",
    "ioredis",
    "cachekey",
    "task-queue",
    "delay-queue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:dts": "tsc -p tsconfig.dts-smoke.json",
    "smoke": "node --import tsx/esm examples/memory-hub/boot.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@ling2/ling-coris": "*"
  },
  "dependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@ling2/ling-coris": "*",
    "@types/node": "^24.10.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
